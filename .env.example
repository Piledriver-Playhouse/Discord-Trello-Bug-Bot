# =============================================================================
# .env.example — Discord Trello Bug Bot
# =============================================================================
#
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# This file is safe to commit. The real .env is in .gitignore.
# See the README or docs for instructions on obtaining each credential.
# =============================================================================

# ── Required ────────────────────────────────────────────────────────────────
# The bot will refuse to start if any of these are missing.

# Bot token from the Discord Developer Portal → Bot → Token.
DISCORD_TOKEN=replace_me

# Numeric channel ID where the bot listens for !bug commands.
# Enable Developer Mode in Discord, right-click the channel, Copy Channel ID.
BUG_CHANNEL_ID=replace_me

# Trello API key from https://trello.com/power-ups/admin → API Key.
TRELLO_API_KEY=replace_me

# Trello authorisation token (generate from the API Key page).
TRELLO_TOKEN=replace_me

# Trello list ID where new bug cards are created.
# Append .json to your board URL and search for the list name to find this.
TRELLO_LIST_ID=replace_me

# ── Optional ────────────────────────────────────────────────────────────────
# These have sensible defaults and can be omitted.

# Prefix character(s) for Discord commands (default: !).
COMMAND_PREFIX=!

# String prepended to every Trello card title (default: Bug:).
CARD_TITLE_PREFIX=Bug:

# Python logging level: DEBUG, INFO, WARNING, ERROR (default: INFO).
LOG_LEVEL=INFO

# Whether to create a Discord thread for every bug report (default: true).
ENABLE_THREADS=true

# Whether to sync Discord attachments to the Trello card (default: true).
ENABLE_ATTACHMENTS=true

# Trello list ID to watch for "Fixed" cards (Optional).
# If a card is moved here, the bot notifies the original Discord thread.
TRELLO_DONE_LIST_ID=replace_me_if_needed

# Host and port for the incoming Trello webhook listener.
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
